  "env": {
    "ANTHROPIC_BASE_URL": "https://ai.example.com",
    "ANTHROPIC_CUSTOM_HEADERS": "X-Aidevstack-Client: claude-code/dev-cli-2.0.0",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "project-default",
